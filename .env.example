# 复制为 .env 后填写；.env 已被 gitignore，不要提交真实 Key
# 可选大模型（OpenAI 兼容 / 华为云 MaaS）
ZX_LLM_BASE_URL=
ZX_LLM_API_KEY=
ZX_LLM_MODEL=deepseek-chat
# 室外导航（高德 JS API）
AMAP_JS_KEY=
AMAP_SECURITY_CODE=
# 服务端会话密钥；不填则自动生成并持久化到 data/.secret_key
ZX_SECRET_KEY=
# HTTPS 部署时设为 1，启用 Secure Cookie（本地 HTTP 演示保持 0）
ZX_COOKIE_SECURE=0
# 设备上报令牌；设置后 /api/sensor/* 必须带 X-Sensor-Token（演示可留空）
ZX_SENSOR_TOKEN=
