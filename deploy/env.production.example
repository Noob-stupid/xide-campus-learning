# 生产环境变量模板（复制为 /opt/xide/.env，不要提交到 git）
ZX_HOST=0.0.0.0
ZX_PORT=5820
ZX_ENABLE_SWEEPER=1
# 至少 32 字节随机串；不填会自动生成 data/.secret_key
ZX_SECRET_KEY=
# HTTPS 部署后改为 1；纯 HTTP 演示保持 0，否则登录 Cookie 不会发送
ZX_COOKIE_SECURE=0

# 可选大模型（DeepSeek / 华为云 MaaS OpenAI 兼容端点）
ZX_LLM_BASE_URL=
ZX_LLM_API_KEY=
ZX_LLM_MODEL=deepseek-chat

# 设备上报令牌；设置后 /api/sensor/* 需带 X-Sensor-Token
ZX_SENSOR_TOKEN=

# 室外导航（可选）
AMAP_JS_KEY=
AMAP_SECURITY_CODE=