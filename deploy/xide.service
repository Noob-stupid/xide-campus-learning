[Unit]
Description=Xide KeepLit (Flask + Gunicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/xide
EnvironmentFile=/opt/xide/.env
ExecStart=/opt/xide/.venv/bin/gunicorn -b 0.0.0.0:5820 -w 1 --threads 4 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# 启用：
#   sudo cp deploy/xide.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now xide
#   sudo systemctl status xide